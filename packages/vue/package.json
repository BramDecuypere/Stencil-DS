{
  "name": "@nemo/vue",
  "version": "0.0.1",
  "description": "Nemo Design System — typed Vue 3 component wrappers, generated from @nemo/components via @stencil/vue-output-target.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p . --outDir ./dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@nemo/components": "*"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vue": "^3.4.0"
  }
}
