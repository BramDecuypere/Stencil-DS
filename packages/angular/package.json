    "@nemo/components": "*",
    "@storybook/test-runner": "0.23.0",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "^21.2.17",
    "@angular/compiler-cli": "^15.0.4",
    "@angular/core": "^21.2.17",
    "@stencil/angular-output-target": "^1.1.1",
    "ng-packagr": "^15.2.2",
    "rxjs": "^7.8.0",
    "typescript": "^5.5.4",
    "zone.js": "^0.15.0"
  },
  "publishConfig": {
